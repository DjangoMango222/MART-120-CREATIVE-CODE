function setup() {
  createCanvas(500, 600);
}

function draw() {
  background(180, 45, 78); // Background color
  
  // Head
  strokeWeight(10);
  fill(876);
  point(100, 75);  // First point
  point(285, 75);  // Second point
  triangle(240, 230, 303, 30, 30, 30); // Triangle for the head

  // Eyes
  fill(255);
  circle(75, 60, 50);  // Left eye
  circle(150, 60, 50); // Right eye
  fill(0);  // Eye color
  circle(75, 60, 20);  // Left pupil
  circle(150, 60, 20); // Right pupil
  
  // Smoke line
  line(130, 175, 175, 50);

  // Body
  fill(100, 24, 120);
  rect(200, 185, 100, 150); // Body
  
  // Decoration
  fill(255);
  triangle(1, 220, 250, 120, 180, 220); // Decorative triangle

  // Arms
  fill(10, 24, 120);
  rect(300, 195, 100, 10); // Right arm
  rect(100, 195, 100, 10); // Left arm

  // Legs
  rect(200, 335, 10, 20); // Left leg
  rect(290, 335, 10, 20); // Right leg

  // Text at the bottom
  fill(0);
  textSize(25);
  text("Django Behunin", 175, 500);
}
